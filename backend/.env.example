# SQLite file, created automatically on first start (relative to backend/).
DATABASE_URL=sqlite:///./route53.db
# Set to true behind HTTPS so the session cookie is only sent over TLS.
SESSION_COOKIE_SECURE=false
SESSION_TTL_HOURS=168
# Comma-separated origins; only needed if the frontend is served from a different origin than the API.
CORS_ORIGINS=
# Seed the demo user and sample zones when the database is empty.
AUTO_SEED=true
# Mocked propagation delay before a change goes from PENDING to INSYNC.
CHANGE_PROPAGATION_SECONDS=2
